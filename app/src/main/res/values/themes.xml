<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Splash / window-background theme used before Compose takes over.
        Material 3 colour scheme is supplied at runtime by OrbitLauncherTheme.
    -->
    <style name="Theme.OrbitLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/orbit_indigo_10</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
